# Copy this file to .env and set real values before running in production.

# Django secret key (make this unique and keep it secret)
DJANGO_SECRET_KEY=your-secret-key

# Debug mode
DJANGO_DEBUG=True

# Email backend settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=webmaster@example.com

# Optional: override allowed hosts (space-separated values)
ALLOWED_HOSTS=localhost 127.0.0.1

# Database settings
# When DJANGO_DB_ENGINE is not set, local DEBUG mode falls back to sqlite.
# To use MySQL, uncomment and set your MySQL credentials.
# DJANGO_DB_ENGINE=django.db.backends.mysql
# DJANGO_DB_NAME=chat
# DJANGO_DB_USER=root
# DJANGO_DB_PASSWORD=your-db-password
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=3306
